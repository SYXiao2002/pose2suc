{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pose2suc.local/schema/grasp_annotation.schema.json",
  "title": "Suction grasp annotation 1.0",
  "$comment": "Frozen v1.0. x-unitVector, x-nonParallel and x-uniqueBy are semantic assertions implemented by validate_annotation.py and src/validation.js; ordinary JSON Schema engines check only structural constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_id", "normal_convention", "grasps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "object_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "normal_convention": {"const": "outward_surface"},
    "grasps": {
      "type": "array", "minItems": 1, "x-uniqueBy": "grasp_id",
      "items": {"$ref": "#/$defs/grasp"}
    }
  },
  "$defs": {
    "vector": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}
    },
    "unitVector": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "number"}, "x-unitVector": 0.001
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["point_obj", "score"],
      "properties": {
        "point_obj": {"$ref": "#/$defs/vector"},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "center_obj", "normal_obj", "normal_source", "radius_m", "tangent_ref_obj"],
      "x-nonParallel": {"normal": "normal_obj", "tangent": "tangent_ref_obj", "threshold": 0.001},
      "properties": {
        "type": {"const": "disk"},
        "center_obj": {"$ref": "#/$defs/vector"},
        "normal_obj": {"$ref": "#/$defs/unitVector"},
        "normal_source": {"enum": ["manual", "auto_fitted", "manual_corrected"]},
        "radius_m": {"type": "number", "exclusiveMinimum": 0},
        "tangent_ref_obj": {"$ref": "#/$defs/unitVector"}
      }
    },
    "grasp": {
      "type": "object", "additionalProperties": false,
      "required": ["grasp_id", "priority", "status", "contact_region"],
      "properties": {
        "grasp_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "priority": {"type": "integer", "minimum": 1},
        "status": {"enum": ["verified", "pending", "deprecated"]},
        "notes": {"type": "string", "default": ""},
        "contact_region": {"$ref": "#/$defs/region"},
        "candidate_points": {"type": "array", "items": {"$ref": "#/$defs/candidate"}, "default": []}
      }
    }
  }
}
